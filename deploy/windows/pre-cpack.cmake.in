if(CPACK_GENERATOR MATCHES 7Z|ZIP)
  string(REPLACE " " "*" _TEMP_LIST "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
  set(${PORTABLE_LIBS} "")
  foreach(ITEM ${_TEMP_LIST})
    string(REPLACE "*" " " _ITEM ${ITEM})
    file(COPY ${_ITEM} DESTINATION ${CPACK_TEMPORARY_INSTALL_DIRECTORY})
  endforeach()
  file(MAKE_DIRECTORY ${CPACK_TEMPORARY_INSTALL_DIRECTORY}/settings)
  file(WRITE ${CPACK_TEMPORARY_INSTALL_DIRECTORY}/settings/@CMAKE_PROJECT_PROPER_NAME@.conf " ")
  file(REMOVE ${CPACK_TEMPORARY_INSTALL_DIRECTORY}/deskflow-daemon.exe)
  file(WRITE ${CPACK_TEMPORARY_INSTALL_DIRECTORY}/README-PORTABLE.txt
" Portable @CMAKE_PROJECT_PROPER_NAME@: @CMAKE_PROJECT_VERSION@

  Keep settings/@CMAKE_PROJECT_PROPER_NAME@.conf beside the application. This marker keeps configuration and trust data inside the portable folder instead of the installed application's system settings location.
  Removing the portable folder also removes its local configuration. Back up the settings folder first if you want to keep it.
  The portable version does not include the background service, so input sharing is unavailable at UAC prompts and the Windows login screen.
")
endif()
